{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cdis-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python",
      "runtimeArgs": ["backend/manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "cdis-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
